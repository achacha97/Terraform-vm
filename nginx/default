server {
    listen 80;
    server_name _;  # Répond à tous les domaines

    # Journalisation spécifique
    access_log /var/log/nginx/prod-access.log;
    error_log /var/log/nginx/prod-error.log;

    # Paramètres de sécurité de base
    server_tokens off;  # Cache les infos de version de Nginx
    client_max_body_size 10m;  # Limite la taille des uploads

    location / {
        proxy_pass http://localhost:4000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_cache_bypass $http_upgrade;
        
        # Ajouts recommandés
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        
        # Timeouts
        proxy_connect_timeout 60s;
        proxy_read_timeout 60s;
        proxy_send_timeout 60s;
    }

    # Bloquer l'accès aux fichiers cachés
    location ~ /\.(env|git|ht) {
        deny all;
        return 404;
    }

    # Health check endpoint
    location /health {
        access_log off;
        return 200 'OK';
        add_header Content-Type text/plain;
    }
}
