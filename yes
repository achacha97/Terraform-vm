terraform {
  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = "~> 5.0"
    }
  }
}

provider "aws" {
  region = var.region
}

resource "aws_instance" "linux_vm" {
  ami           = var.ami_id
  instance_type = var.instance_type
  tags = {
    Name = "MyFirstTerraformVM"
  }
}

